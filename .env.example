# Copy to .env and fill in. .env is in .gitignore: never commit it.

# Needed by the triager for LLM triage (https://aistudio.google.com/apikey).
# Without it, everything else still runs; releases keep their rules verdict.
GEMINI_API_KEY=

# Optional: the Gemini model the triager uses (default: gemini-flash-lite-latest).
# GEMINI_MODEL=

# Only for running crotalus outside Docker (from a virtualenv, or pytest).
# Inside Docker, docker-compose.yml sets it to the db container.
DATABASE_URL=postgresql://crotalus:crotalus@localhost:5432/crotalus
